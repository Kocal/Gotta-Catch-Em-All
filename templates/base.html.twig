<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="ltr" style="scrollbar-gutter: stable">
    <head>
        <meta charset="UTF-8">
        <title>{{ block('title') }}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block stylesheets %}
            <style>
                /* Generated through fontpie, e.g.: "pnpx fontpie assets/vendor/inter-ui/variable/InterVariable.woff2" */
                @font-face { font-family: 'Inter Variable Fallback'; font-style: normal; font-weight: 400; src: local('Arial'); ascent-override: 89.79%; descent-override: 22.36%; line-gap-override: 0.00%; size-adjust: 107.89%; }
                @font-face { font-family: 'Inter Variable Fallback'; font-style: normal; font-weight: 600; src: local('Arial Bold'); ascent-override: 97.15%; descent-override: 24.19%; line-gap-override: 0.00%; size-adjust: 99.72%; }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        <meta name="color-scheme" content="dark light">
        <meta name="view-transition" content="same-origin" />

        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="#60a5fa" />
    </head>
    <body class="antialiased min-h-dvh flex flex-col bg-blue-300 text-blue-50">
    {% block body %}
        <div class="flex-1">
            {% block main %}{% endblock %}
        </div>

        <footer class="bg-blue-400 mt-4">
            <div class="py-2 text-center text-sm">
                <twig:ux:icon name="lucide:copyleft" class="inline-block" />
               {{ "now"|date("Y") }} Kocal -
                <a href="https://github.com/Kocal/Gotta-Catch-Em-All/" class="hover:underline">
                    <twig:ux:icon name="mdi:github" class="inline-block" />
                    See on GitHub
                </a>

                {% if app.user %}
                    <span class="mx-2">|</span>
                    <a href="{{ path('app_logout') }}" class="hover:underline">
                        <twig:ux:icon name="lucide:log-out" class="inline-block" />
                        Logout
                    </a>
                {% else %}
                    <span class="mx-2">|</span>
                    <a href="{{ path('app_login') }}" class="hover:underline">
                        <twig:ux:icon name="lucide:log-in" class="inline-block" />
                        Login
                    </a>
                {% endif %}

            </div>
        </footer>
    {% endblock %}
    </body>
</html>
