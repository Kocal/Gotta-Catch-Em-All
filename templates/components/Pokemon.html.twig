{% props isLogged, pokemon, caughtPokemons %}
{% if isLogged %}
<a
    href="{{ path('app_toggle_pokemon_caught', {pokemonId: pokemon.id}) }}"
    onclick="this.querySelector('img').classList.toggle('grayscale-100');"
>
    {% endif %}
    <img
        src="{{ asset('images/pokemon/' ~ pokemon.id ~ '.png') }}"
        alt="{{ pokemon.name }}"
        title="{{ pokemon.name }} #{{ pokemon.id }} ({{ pokemon.getCatchableInGamesLabel() }})"
        class="select-none {{ caughtPokemons[pokemon.id.toInt] is defined ? '' : 'grayscale-100' }} w-full place-self-center"
    />
    {% if isLogged %}
</a>
{% endif %}
