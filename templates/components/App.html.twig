{% set pokemons = this.getPokemons() %}
{% set caughtPokemons = this.getCaughtPokemons() %}
{% set user = app.user %}
{% set uncaughtClass = 'grayscale-100' %}
<div
    {{ attributes }}
    {% if user is not null %}
        data-controller="pokemon"
        data-pokemon-caught-class=""
        data-pokemon-uncaught-class="{{ uncaughtClass }}"
    {% endif %}
>
    <h1 class="font-mono font-mono-shadow-[2] md:font-mono-shadow-[4] md:text-3xl text-center  font-bold my-6">
        Gotta Catch 'Em All (3rd Gen) (<span data-pokemon-target="counter">{{ caughtPokemons|length }}</span> / {{ pokemons|length }})
    </h1>
    <div class="grid md:grid-cols-5 auto-rows-fr gap-2 gap-y-4">
        {% for boxIndex in 1..boxesCount %}
            <twig:PokemonBox>
                <twig:block name="title">
                    {{ pokemonPerBox * (boxIndex - 1) + 1 }} - {{ pokemonPerBox * boxIndex }}
                    ({{ boxIndex }} / {{ boxesCount }})
                </twig:block>
                <twig:block name="content">
                    {% for pokemon in pokemons|slice(pokemonPerBox * (boxIndex - 1), pokemonPerBox) %}
                        {% set isCaught = caughtPokemons[pokemon.id.toInt] is defined %}
                        {% if user is not null %}
                            <button
                                type="button"
                                data-pokemon-toggle-url="{{ path('app_toggle_pokemon_caught', {pokemonId: pokemon.id}) }}"
                                data-pokemon-caught="{{ isCaught ? 'true' : 'false' }}"
                                data-action="click->pokemon#toggle"
                                class="cursor-pointer"
                            >
                                <img
                                    src="{{ asset('images/pokemon/' ~ pokemon.id ~ '.png') }}"
                                    alt="{{ pokemon.name }}"
                                    title="{{ pokemon.name }} #{{ pokemon.id }} ({{ pokemon.getCatchableInGamesLabel() }})"
                                    class="select-none {{ isCaught ? '' : uncaughtClass }} w-full place-self-center"
                                />
                            </button>
                        {% else %}
                            <img
                                src="{{ asset('images/pokemon/' ~ pokemon.id ~ '.png') }}"
                                alt="{{ pokemon.name }}"
                                title="{{ pokemon.name }} #{{ pokemon.id }} ({{ pokemon.getCatchableInGamesLabel() }})"
                                class="select-none {{ isCaught ? '' : uncaughtClass }} w-full place-self-center"
                            />
                        {% endif %}
                    {% endfor %}
                </twig:block>
            </twig:PokemonBox>
        {% endfor %}
    </div>
</div>
